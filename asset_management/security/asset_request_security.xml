<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            ASSET REQUEST RECORD RULES:
            ============================
            Rule 1 (Group: Internal User):
              - Creator can see their own requests
              - Department manager can see requests from their dept
              - Asset Category Admin (customer_id on asset.type) can see approved/received requests

            Rule 2 (Group: Assets Admin):
              - Full access to everything

            Rule 3 (Global):
              - Same combined logic — ensures no user sees records outside their scope
        -->

        <!-- Rule 1: Internal User visibility — includes Asset Category Admin -->
        <record id="asset_request_user_rule" model="ir.rule">
            <field name="name">Asset Request: User/Manager/Category Admin Visibility</field>
            <field name="model_id" ref="model_asset_request"/>
            <field name="domain_force">
                [
                    '|', '|',
                    ('create_uid', '=', user.id),
                    ('department_id.manager_id.user_id', '=', user.id),
                    '&amp;',
                    ('asset_category_id.customer_ids', 'in', [user.id]),
                    ('status', 'in', ['approved', 'received'])
                ]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule 2: Global Asset Admin — full access to ALL requests -->
        <record id="asset_request_admin_rule" model="ir.rule">
            <field name="name">Asset Request: Global Admin Full Access</field>
            <field name="model_id" ref="model_asset_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('assets_global_admin_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule 3: Asset Request Admin — only sees requests for their own asset types -->
        <record id="asset_request_category_admin_rule" model="ir.rule">
            <field name="name">Asset Request: Category Admin Visibility</field>
            <field name="model_id" ref="model_asset_request"/>
            <field name="domain_force">
                [
                    '|',
                    ('create_uid', '=', user.id),
                    '&amp;',
                    ('asset_category_id.customer_ids', 'in', [user.id]),
                    ('status', 'in', ['approved', 'received'])
                ]
            </field>
            <field name="groups" eval="[(4, ref('asset_request_admin_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
