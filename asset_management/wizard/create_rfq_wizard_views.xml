<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_create_rfq_wizard_form" model="ir.ui.view">
        <field name="name">asset.create.rfq.wizard.form</field>
        <field name="model">asset.create.rfq.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Request for Quotation">
                <group>
                    <field name="creation_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="vendor_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="reference_number_id" invisible="creation_type != 'exist'" required="creation_type == 'exist'"/>
                    <field name="asset_type_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate_rfq" string="Create RFQ" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_create_rfq_wizard" model="ir.actions.act_window">
        <field name="name">Create RFQ</field>
        <field name="res_model">asset.create.rfq.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
