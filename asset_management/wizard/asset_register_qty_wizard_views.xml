<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_register_qty_wizard_form" model="ir.ui.view">
        <field name="name">asset.register.qty.wizard.form</field>
        <field name="model">asset.register.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Quantity">
                <group>
                    <field name="max_qty" readonly="1" string="Pending to Register"/>
                    <field name="quantity" string="Quantity to Mark as Registered"/>
                    <field name="location_id"/>
                    <field name="asset_model"/>
                    <field name="asset_admin_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_confirm_registration" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
