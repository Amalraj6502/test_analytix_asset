<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_quantity_wizard_form" model="ir.ui.view">
        <field name="name">update.quantity.wizard.form</field>
        <field name="model">update.quantity.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Quantity">
                <group>
                    <field name="quantity"/>
                    <field name="reference_number_id"/>
                    <field name="vendor_new_id"/>
                    <field name="vendor_bill_id"/>
                    <field name="purchase_price"/>
                    <field name="invoice_attachment_ids" widget="many2many_binary"
                                   options="{'filename':'name'}"/>
                    <field name="buy_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_quantity_wizard" model="ir.actions.act_window">
        <field name="name">Update Quantity</field>
        <field name="res_model">update.quantity.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
