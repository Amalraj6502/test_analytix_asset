<odoo>
    <record id="view_company_form_inherit_asset_prefix" model="ir.ui.view">
        <field name="name">res.company.form.asset.prefix</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add after company name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_code" placeholder="Ex: ANX"/>
            </xpath>

        </field>
    </record>
</odoo>