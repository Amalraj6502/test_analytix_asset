<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="asset_management.AssetDashboard" owl="1">
    <div class="o_asset_dashboard">

        <!-- ── LOADING OVERLAY ─────────────────────────────────────── -->
        <t t-if="state.loading">
            <div class="adash-loading">
                <div class="adash-spinner"></div>
                <span>Loading Dashboard…</span>
            </div>
        </t>

        <t t-else="">
            <!-- ── HEADER ───────────────────────────────────────────── -->
            <div class="adash-header">
                <div class="adash-header-left">
                    <h1 class="adash-title">Asset Dashboard</h1>
                    <div class="adash-subtitle">
                        <span t-esc="state.data.total_asset_types"/> asset types ·
                        <t t-if="state.data.company_name">
                            <span t-esc="state.data.company_name"/> ·
                        </t>
                        All Companies
                    </div>
                </div>
                <div class="adash-header-actions">
                    <button class="adash-btn-export" t-on-click="onExport">
                        <i class="fa fa-upload me-1"/>
                        Export
                    </button>
                    <button class="adash-btn-new" t-on-click="onNewAssetType">
                        <i class="fa fa-plus me-1"/>
                        + New Asset Type
                    </button>
                </div>
            </div>

            <!-- ── STAT CARDS ROW ────────────────────────────────────── -->
            <div class="adash-stats-row">

                <!-- Asset Types -->
                <div class="adash-stat-card adash-stat-amber" t-on-click="() => this.onStatClick('asset_types')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#d97706,#f59e0b);">
                        <i class="fa fa-th-large"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.total_asset_types"/>
                        <div class="adash-stat-label">ASSET TYPES</div>
                        <div class="adash-stat-sub">
                            <span class="text-success" t-esc="state.data.storable_count"/> Storable ·
                            <span class="text-info" t-esc="state.data.service_count"/> Service
                        </div>
                    </div>
                </div>

                <!-- Total Assets -->
                <div class="adash-stat-card adash-stat-slate" t-on-click="() => this.onStatClick('total_assets')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#334155,#475569);">
                        <i class="fa fa-desktop"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.total_assets"/>
                        <div class="adash-stat-label">TOTAL ASSETS</div>
                        <div class="adash-stat-sub">All categories</div>
                    </div>
                </div>

                <!-- In Stock -->
                <div class="adash-stat-card adash-stat-green" t-on-click="() => this.onStatClick('in_stock')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#16a34a,#22c55e);">
                        <i class="fa fa-check-square"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.in_stock"/>
                        <div class="adash-stat-label">IN STOCK</div>
                        <div class="adash-stat-sub">Available</div>
                    </div>
                </div>

                <!-- Assigned -->
                <div class="adash-stat-card adash-stat-indigo" t-on-click="() => this.onStatClick('assigned')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#4f46e5,#6366f1);">
                        <i class="fa fa-user"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.assigned"/>
                        <div class="adash-stat-label">ASSIGNED</div>
                        <div class="adash-stat-sub">In use</div>
                    </div>
                </div>

                <!-- In Repair -->
                <div class="adash-stat-card adash-stat-red" t-on-click="() => this.onStatClick('in_repair')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#9f1239,#be123c);">
                        <i class="fa fa-wrench"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.in_repair"/>
                        <div class="adash-stat-label">IN REPAIR</div>
                        <div class="adash-stat-sub">Under maintenance</div>
                    </div>
                </div>

                <!-- Transfers -->
                <div class="adash-stat-card adash-stat-cyan" t-on-click="() => this.onStatClick('transfers')">
                    <div class="adash-stat-icon" style="background: linear-gradient(135deg,#0284c7,#0ea5e9);">
                        <i class="fa fa-exchange"/>
                    </div>
                    <div class="adash-stat-body">
                        <div class="adash-stat-number" t-esc="state.data.transfers"/>
                        <div class="adash-stat-label">TRANSFERS</div>
                        <div class="adash-stat-sub text-success">Active entries</div>
                    </div>
                </div>

            </div>

            <!-- ── CHART PANELS ROW ──────────────────────────────────── -->
            <div class="adash-charts-row">

                <!-- By Category (polar area) -->
                <div class="adash-chart-card">
                    <div class="adash-chart-header">
                        <span class="adash-chart-title">By Category</span>
                    </div>
                    <div class="adash-chart-body">
                        <canvas id="by-category-chart"/>
                    </div>
                </div>

                <!-- Asset Status distribution (doughnut) -->
                <div class="adash-chart-card adash-chart-wide">
                    <div class="adash-chart-header">
                        <span class="adash-chart-title">Asset Status</span>
                        <span class="adash-chart-sub">distribution</span>
                    </div>
                    <div class="adash-chart-body">
                        <canvas id="asset-status-chart"/>
                    </div>
                </div>

                <!-- Types per Category (horizontal bar) -->
                <div class="adash-chart-card adash-chart-wide">
                    <div class="adash-chart-header">
                        <span class="adash-chart-title">Types per Category</span>
                        <span class="adash-chart-sub">count</span>
                    </div>
                    <div class="adash-chart-body">
                        <canvas id="types-category-chart"/>
                    </div>
                </div>

            </div>

            <!-- ── CATEGORY FILTER BAR ───────────────────────────────── -->
            <div class="adash-filter-bar">
                <div class="adash-filter-left">
                    <span class="adash-filter-label">Category:</span>

                    <!-- All chip -->
                    <button
                        t-attf-class="adash-chip #{state.activeCategory === 'all' ? 'adash-chip-active' : ''}"
                        t-on-click="() => this.onCategoryClick('all')"
                    >
                        All <span class="adash-chip-count" t-esc="state.data.total_asset_types"/>
                    </button>

                    <!-- Per-category chips -->
                    <t t-foreach="categories" t-as="cat" t-key="cat.key">
                        <button
                            t-attf-class="adash-chip #{state.activeCategory === cat.key ? 'adash-chip-active' : ''}"
                            t-on-click="() => this.onCategoryClick(cat.key)"
                        >
                            <span t-esc="cat.emoji"/> <span t-esc="cat.label"/>
                        </button>
                    </t>
                </div>

                <!-- Search -->
                <div class="adash-filter-right">
                    <div class="adash-search-wrap">
                        <i class="fa fa-search adash-search-icon"/>
                        <input
                            type="text"
                            class="adash-search-input"
                            placeholder="Search asset type or code…"
                            t-on-input="onSearch"
                        />
                    </div>
                </div>
            </div>

        </t>
    </div>
</t>

</templates>
